CONFIG_IDF_TARGET="esp32c6"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_MATTER_ENABLE_DATA_MODEL=y
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=y
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=16
CONFIG_ESP_MATTER_AGGREGATOR_ENDPOINT_COUNT=1

# SmartRoom defaults
CONFIG_SMARTROOM_IR_RX_GPIO=19
CONFIG_SMARTROOM_IR_TX_GPIO=18
CONFIG_SMARTROOM_BUTTON_GPIO=9
CONFIG_SMARTROOM_IR_RESOLUTION_HZ=1000000
CONFIG_SMARTROOM_IR_DEFAULT_CARRIER_HZ=38000
CONFIG_SMARTROOM_IR_MAX_SYMBOLS=512
CONFIG_SMARTROOM_IR_MAX_SIGNALS=24
CONFIG_SMARTROOM_LEARN_LONG_PRESS_MS=1500
CONFIG_SMARTROOM_LEARN_TIMEOUT_MS=12000
CONFIG_SMARTROOM_BUTTON_DEBOUNCE_MS=40
CONFIG_SMARTROOM_RGB_BACKEND_NONE=y
