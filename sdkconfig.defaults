# SmartRoom development profile; no network credentials belong in this file.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# Configured image capacity, not a confirmation of the physical board flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_MATTER_ENABLE_DATA_MODEL=y
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=y
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=32
CONFIG_ENABLE_CHIP_DATA_MODEL=y
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_WIFI_NETWORK_COMMISSIONING_DRIVER=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_ENABLE_CHIPOBLE=y
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y
# CONFIG_OPENTHREAD_ENABLED is not set
# CONFIG_ESP_MATTER_ENABLE_OPENTHREAD is not set
# CONFIG_ENABLE_MATTER_OVER_THREAD is not set
# CONFIG_ENABLE_CHIP_SHELL is not set

CONFIG_FREERTOS_HZ=1000
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_MDNS_MAX_SERVICES=10
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# NVS encryption/attestation provisioning require a separate production design.
CONFIG_NVS_ENCRYPTION=n
