# SmartRoom Matter Configuration

# Compiler optimizations
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# ESP Matter Configuration
# Flash Configuration (ESP32-C6 usually has 4MB flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Matter Configuration
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ESP_MATTER_ENABLE_DATA_MODEL=y
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=y

# WiFi Configuration
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# Bluetooth/BLE Configuration - REQUIRED for Matter commissioning
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Thread (optional - für HomeKit Thread support)
# CONFIG_ESP_MATTER_ENABLE_OPENTHREAD=y
# CONFIG_OPENTHREAD_ENABLED=y

# NVS Configuration
CONFIG_NVS_ENCRYPTION=n

# FreeRTOS Configuration
CONFIG_FREERTOS_HZ=1000

# Matter Stack Configuration
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_CHIP_DATA_MODEL=y

# mbedTLS Configuration (für Matter HKDF Support)
CONFIG_MBEDTLS_HKDF_C=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=n

# Log levels
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# LWIP
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# mDNS
CONFIG_MDNS_MAX_SERVICES=10

# ESP System
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Matter Device Info
CONFIG_DEVICE_TYPE_ESP32_C6_DEVKITC=y
CONFIG_EXAMPLE_WIFI_SSID="FRITZ!Box Fon WLAN 7390"
CONFIG_EXAMPLE_WIFI_PASSWORD="3946060518250164"
